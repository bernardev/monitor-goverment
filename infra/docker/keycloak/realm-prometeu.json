{
  "realm": "prometeu",
  "displayName": "Prometeu",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "cidadao",
        "description": "Conta de cidadão: acompanhar e receber alertas."
      },
      {
        "name": "curador",
        "description": "Registra promessas, fontes e capturas; propõe vereditos."
      },
      {
        "name": "revisor",
        "description": "Publica ou recusa vereditos propostos por outra pessoa."
      },
      {
        "name": "editor_chefe",
        "description": "Responde pela linha editorial; pode publicar e recusar vereditos."
      },
      {
        "name": "administrador",
        "description": "Administra contas e configurações."
      },
      {
        "name": "default-roles-prometeu",
        "description": "Papéis de toda conta nova: cidadão.",
        "composite": true,
        "composites": {
          "realm": ["cidadao"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "prometeu-api",
      "name": "API do Prometeu",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "curadoria",
      "name": "Painel de curadoria",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "desenvolvimento",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3002/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-prometeu-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "prometeu-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "site",
      "name": "Site público",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "desenvolvimento",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-prometeu-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "prometeu-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ferramentas-locais",
      "name": "Testes locais por linha de comando (não existe em produção)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audiencia-prometeu-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "prometeu-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
