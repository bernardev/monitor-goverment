{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/votacao-nominal-retificada.v2.json",
  "title": "VotacaoNominalRetificada (v2): dados",
  "description": "Atividade Legislativa: a casa corrigiu uma votação nominal já registrada; traz o estado completo novo. idDoAgregado é o id da votação. A v2 traz quem não votou, quando a casa informa, e aceita votação e voto sem horário.",
  "type": "object",
  "required": [
    "casa",
    "codigoNaFonte",
    "dia",
    "registradaEm",
    "descricao",
    "resultado",
    "secreta",
    "proposicoes",
    "votos",
    "capturaId",
    "capturaDosVotosId",
    "relacaoCompleta",
    "semVoto"
  ],
  "additionalProperties": false,
  "properties": {
    "casa": {
      "enum": ["camara_dos_deputados", "senado_federal"]
    },
    "codigoNaFonte": {
      "type": "string",
      "minLength": 1,
      "description": "Como a casa identifica a votação (2635476-36)."
    },
    "dia": {
      "type": "string",
      "format": "date",
      "description": "Dia do calendário de Brasília em que a votação aconteceu."
    },
    "registradaEm": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "null: a casa não informa o horário (Senado)."
    },
    "descricao": {
      "type": "string",
      "minLength": 1,
      "description": "Descrição da casa, com o resultado e o placar."
    },
    "resultado": {
      "enum": ["aprovada", "rejeitada", "nao_informado"]
    },
    "secreta": {
      "type": "boolean",
      "description": "Votação secreta: todos os votos são secreto."
    },
    "relacaoCompleta": {
      "type": "boolean",
      "description": "A casa listou todos os parlamentares em exercício, inclusive quem não votou."
    },
    "proposicoes": {
      "type": "array",
      "description": "Proposições que a votação afetou, como a casa as identifica.",
      "items": {
        "type": "object",
        "required": ["codigoNaFonte", "sigla", "numero", "ano", "ementa"],
        "additionalProperties": false,
        "properties": {
          "codigoNaFonte": {
            "type": "string",
            "minLength": 1
          },
          "sigla": {
            "type": "string",
            "minLength": 1
          },
          "numero": {
            "type": "integer"
          },
          "ano": {
            "type": "integer"
          },
          "ementa": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "votos": {
      "type": "array",
      "minItems": 1,
      "description": "Um por parlamentar com voto registrado; quem faltou à votação não aparece.",
      "items": {
        "type": "object",
        "required": [
          "pessoaId",
          "mandatoId",
          "opcao",
          "registroNaFonte",
          "registradoEm",
          "siglaPartidoNaFonte"
        ],
        "additionalProperties": false,
        "properties": {
          "pessoaId": {
            "type": "string",
            "format": "uuid"
          },
          "mandatoId": {
            "type": "string",
            "format": "uuid",
            "description": "Mandato de Agentes Públicos exercido no instante do voto."
          },
          "opcao": {
            "enum": ["sim", "nao", "abstencao", "obstrucao", "presidente_da_sessao", "secreto"]
          },
          "registroNaFonte": {
            "type": ["string", "null"],
            "description": "Como a casa escreveu o voto; null na votação secreta."
          },
          "registradoEm": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "siglaPartidoNaFonte": {
            "type": ["string", "null"],
            "description": "Partido do parlamentar no dia, como a casa informou."
          }
        }
      }
    },
    "semVoto": {
      "type": "array",
      "description": "Quem estava em exercício e não votou, com a situação informada pela casa. Vazio quando relacaoCompleta é falso.",
      "items": {
        "type": "object",
        "required": [
          "pessoaId",
          "mandatoId",
          "situacao",
          "motivo",
          "registroNaFonte",
          "siglaPartidoNaFonte"
        ],
        "additionalProperties": false,
        "properties": {
          "pessoaId": {
            "type": "string",
            "format": "uuid"
          },
          "mandatoId": {
            "type": "string",
            "format": "uuid"
          },
          "situacao": {
            "enum": ["presente_sem_voto", "ausente", "ausencia_justificada", "nao_informada"]
          },
          "motivo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["categoria", "descricaoNaFonte"],
                "additionalProperties": false,
                "properties": {
                  "categoria": {
                    "enum": [
                      "licenca_saude",
                      "licenca_gestante",
                      "licenca_paternidade",
                      "licenca_particular",
                      "missao_autorizada",
                      "atividade_parlamentar",
                      "decisao_da_mesa",
                      "outro"
                    ]
                  },
                  "descricaoNaFonte": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ],
            "description": "Só na ausência justificada."
          },
          "registroNaFonte": {
            "type": "string",
            "minLength": 1,
            "description": "Como a casa escreveu a situação (LS, P-NRV)."
          },
          "siglaPartidoNaFonte": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "capturaId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo com o detalhe da votação (ADR-0009)."
    },
    "capturaDosVotosId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo com a lista de votos (ADR-0009)."
    }
  }
}
