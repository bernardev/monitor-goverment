{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/nome-publico-alterado.v1.json",
  "title": "NomePublicoAlterado (v1): dados",
  "description": "Agentes Públicos: o nome público mudou na fonte.",
  "type": "object",
  "required": ["de", "para", "capturaId"],
  "additionalProperties": false,
  "properties": {
    "de": {
      "type": "string"
    },
    "para": {
      "type": "string",
      "minLength": 1
    },
    "capturaId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo que prova o dado (ADR-0009)."
    }
  }
}
