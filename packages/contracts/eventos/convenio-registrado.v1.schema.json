{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/convenio-registrado.v1.json",
  "title": "ConvenioRegistrado (v1): dados",
  "description": "Finanças Públicas: convênio pago com emendas, com convenente, objeto, valor e as emendas que o pagam. idDoAgregado é o id do convênio.",
  "type": "object",
  "required": [
    "numero",
    "convenente",
    "objeto",
    "publicadoEm",
    "valorCentavos",
    "emendas",
    "capturaId"
  ],
  "additionalProperties": false,
  "properties": {
    "numero": {
      "type": "string",
      "pattern": "^[0-9A-Z]+$",
      "description": "Número do convênio na fonte."
    },
    "convenente": {
      "type": "string",
      "minLength": 1
    },
    "objeto": {
      "type": ["string", "null"]
    },
    "publicadoEm": {
      "type": "string",
      "format": "date"
    },
    "valorCentavos": {
      "type": "string",
      "pattern": "^-?\\d+$",
      "description": "O valor do convênio inteiro, em centavos (texto)."
    },
    "emendas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigoDaEmenda", "funcao", "subfuncao", "localidade"],
        "additionalProperties": false,
        "properties": {
          "codigoDaEmenda": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "funcao": {
            "type": "object",
            "required": ["codigo", "nome"],
            "additionalProperties": false,
            "properties": {
              "codigo": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              }
            }
          },
          "subfuncao": {
            "type": "object",
            "required": ["codigo", "nome"],
            "additionalProperties": false,
            "properties": {
              "codigo": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              }
            }
          },
          "localidade": {
            "type": "string"
          }
        }
      }
    },
    "capturaId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo que prova o dado (ADR-0009)."
    }
  }
}
