{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/favorecidos-da-emenda-registrados.v1.json",
  "title": "FavorecidosDaEmendaRegistrados (v1): dados",
  "description": "Finanças Públicas: a primeira lista de quem recebeu o dinheiro da emenda, mês a mês; traz o estado completo. idDoAgregado é o id da lista, não o da emenda.",
  "type": "object",
  "required": ["codigoDaEmenda", "recebimentos", "capturaId"],
  "additionalProperties": false,
  "properties": {
    "codigoDaEmenda": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Código da emenda no Portal da Transparência."
    },
    "recebimentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mes", "favorecido", "quantidade", "valorCentavos"],
        "additionalProperties": false,
        "properties": {
          "mes": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "favorecido": {
            "type": "object",
            "required": ["tipo", "documento", "nome", "naturezaJuridica", "uf", "municipio"],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "enum": [
                  "pessoa_juridica",
                  "unidade_gestora",
                  "pessoas_fisicas",
                  "inscricao_generica",
                  "nao_informado"
                ],
                "description": "Só pessoa_juridica e unidade_gestora têm documento e nome; os outros chegam somados, sem dado de cidadão."
              },
              "documento": {
                "type": ["string", "null"],
                "pattern": "^(\\d{14}|\\d{6})$",
                "description": "CNPJ ou código SIAFI da unidade gestora; null no somado."
              },
              "nome": {
                "type": ["string", "null"]
              },
              "naturezaJuridica": {
                "type": ["string", "null"]
              },
              "uf": {
                "type": ["string", "null"],
                "pattern": "^[A-Z]{2}$"
              },
              "municipio": {
                "type": ["string", "null"],
                "description": "Como a fonte escreve; sem código IBGE."
              }
            }
          },
          "quantidade": {
            "type": "integer",
            "minimum": 1,
            "description": "Quantos favorecidos a fonte somou: 1 no identificado."
          },
          "valorCentavos": {
            "type": "string",
            "pattern": "^-?\\d+$",
            "description": "Recebido no mês, em centavos (texto); negativo é estorno."
          }
        }
      }
    },
    "capturaId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo que prova o dado (ADR-0009)."
    }
  }
}
