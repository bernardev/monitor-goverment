{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/vinculo-sugerido.v1.json",
  "title": "VinculoSugerido (v1): dados",
  "description": "Compromissos: um fato foi sugerido como evidência; ainda não conta para o estágio.",
  "type": "object",
  "required": ["vinculoId", "tipoDoAlvo", "idDoAlvo", "estagioQueComprova", "origem", "evidencias"],
  "additionalProperties": false,
  "properties": {
    "vinculoId": {
      "type": "string",
      "format": "uuid"
    },
    "tipoDoAlvo": {
      "enum": ["proposicao", "ato_normativo", "acao_orcamentaria", "emenda", "obra"]
    },
    "idDoAlvo": {
      "type": "string",
      "format": "uuid"
    },
    "estagioQueComprova": {
      "enum": ["ato", "orcamento", "execucao", "entrega"]
    },
    "origem": {
      "enum": ["curador", "sugestao_ia"]
    },
    "evidencias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
