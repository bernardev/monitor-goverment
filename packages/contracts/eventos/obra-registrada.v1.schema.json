{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometeu.org/contratos/eventos/obra-registrada.v1.json",
  "title": "ObraRegistrada (v1): dados",
  "description": "Obras: obra paga com emenda parlamentar, com situação, medição, interrupções e as emendas que a pagam; estado completo. idDoAgregado é o id da obra.",
  "type": "object",
  "required": [
    "idNaFonte",
    "nome",
    "descricao",
    "natureza",
    "especie",
    "situacao",
    "situacaoNaFonte",
    "uf",
    "municipios",
    "pontos",
    "endereco",
    "inicioPrevisto",
    "fimPrevisto",
    "inicioEfetivo",
    "fimEfetivo",
    "investimentoPrevistoCentavos",
    "executores",
    "medicao",
    "interrupcoes",
    "emendas",
    "capturaId"
  ],
  "additionalProperties": false,
  "properties": {
    "idNaFonte": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}-\\d{2}$",
      "description": "Projeto de investimento no Obrasgov.br."
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": ["string", "null"]
    },
    "natureza": {
      "type": ["string", "null"]
    },
    "especie": {
      "type": ["string", "null"]
    },
    "situacao": {
      "enum": ["planejada", "em_execucao", "paralisada", "concluida", "cancelada", "inacabada"]
    },
    "situacaoNaFonte": {
      "type": "string"
    },
    "uf": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    },
    "municipios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codigoIbge", "nome"],
        "additionalProperties": false,
        "properties": {
          "codigoIbge": {
            "type": "string",
            "pattern": "^\\d{7}$"
          },
          "nome": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "pontos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "longitude": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        }
      }
    },
    "endereco": {
      "type": ["string", "null"]
    },
    "inicioPrevisto": {
      "type": ["string", "null"],
      "format": "date"
    },
    "fimPrevisto": {
      "type": ["string", "null"],
      "format": "date"
    },
    "inicioEfetivo": {
      "type": ["string", "null"],
      "format": "date"
    },
    "fimEfetivo": {
      "type": ["string", "null"],
      "format": "date"
    },
    "investimentoPrevistoCentavos": {
      "type": "string",
      "pattern": "^-?\\d+$",
      "description": "Centavos inteiros, em texto: JSON não tem inteiro de 64 bits."
    },
    "executores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "cnpj"],
        "additionalProperties": false,
        "properties": {
          "nome": {
            "type": ["string", "null"]
          },
          "cnpj": {
            "type": ["string", "null"],
            "pattern": "^\\d{14}$"
          }
        }
      }
    },
    "medicao": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["percentualCentesimos", "em"],
          "additionalProperties": false,
          "properties": {
            "percentualCentesimos": {
              "type": "integer",
              "minimum": 0,
              "description": "Centésimos de ponto percentual: 2335 é 23,35%."
            },
            "em": {
              "type": ["string", "null"],
              "format": "date"
            }
          }
        }
      ]
    },
    "interrupcoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tipo", "em", "justificativa"],
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "enum": ["paralisada", "cancelada", "inacabada"]
          },
          "em": {
            "type": "string",
            "format": "date"
          },
          "justificativa": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "emendas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codigoDaEmenda",
          "ugEmitente",
          "numeroDoEmpenho",
          "acaoOrcamentaria",
          "empenhadoCentavos",
          "emitidoEm"
        ],
        "additionalProperties": false,
        "properties": {
          "codigoDaEmenda": {
            "type": "string",
            "pattern": "^\\d{12}$"
          },
          "ugEmitente": {
            "type": "string"
          },
          "numeroDoEmpenho": {
            "type": "string",
            "minLength": 1
          },
          "acaoOrcamentaria": {
            "type": ["string", "null"]
          },
          "empenhadoCentavos": {
            "type": "string",
            "pattern": "^-?\\d+$",
            "description": "Centavos inteiros, em texto: JSON não tem inteiro de 64 bits."
          },
          "emitidoEm": {
            "type": ["string", "null"],
            "format": "date"
          }
        }
      }
    },
    "capturaId": {
      "type": "string",
      "format": "uuid",
      "description": "Captura do Acervo que prova o dado (ADR-0009)."
    }
  }
}
