# Copie para .env e ajuste. Nunca versione o .env.
POSTGRES_PASSWORD=desenvolvimento
# Porta do PostgreSQL local; mude se a 5432 já estiver ocupada na sua máquina.
POSTGRES_PORTA=5432
DATABASE_URL=postgres://prometeu_admin:desenvolvimento@localhost:5432/prometeu

INGESTAO_DATABASE_URL=postgres://ctx_ingestao:desenvolvimento@localhost:5432/prometeu

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=prometeu
S3_SECRET_KEY=desenvolvimento
S3_BALDE_BRONZE=prometeu-bronze
S3_BALDE_CAPTURAS=prometeu-capturas

PORT=3000

# Aviso de falha das coletas (opcional): webhook de entrada do Slack, Mattermost, Discord ou Teams.
ALERTA_WEBHOOK_URL=

# Identidade (ADR-0014): Keycloak local de infra/docker.
KEYCLOAK_PORTA=8080
IDENTIDADE_EMISSOR=http://localhost:8080/realms/prometeu
IDENTIDADE_AUDIENCIA=prometeu-api

# Painel de curadoria. O segredo da sessão cifra o cookie: use um valor aleatório longo fora do local.
API_URL=http://localhost:3000
CURADORIA_URL=http://localhost:3002
CURADORIA_CLIENTE_ID=curadoria
CURADORIA_CLIENTE_SEGREDO=desenvolvimento
CURADORIA_SEGREDO_DA_SESSAO=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
